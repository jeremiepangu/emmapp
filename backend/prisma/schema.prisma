generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DG
  CHEF_PRODUCTION
  CHEF_EXPLOITATION
  CHARGE_EXPLOITATION
  RESP_QUALITE
  MAGASINIER
  AGENT_CHARGEUR
  LIVREUR
  CHARGE_LIVRAISON
  COMMERCIAL
  DELEGUE_COMMERCIAL
  CAISSIER
  COMPTABLE
  RH
  SUPERVISEUR
  IT_GED
  DATA_ANALYST
  RESP_SECURITE
  RESP_DURABILITE
}

enum ClientSegment {
  PARTICULIER
  BOUTIQUE
  DETAILLANT
  SUPERMARCHE
  ENTREPRISE
  HOTEL_RESTAURANT
}

enum ProductFormat {
  BIDON_5L
  BIDON_10L
  BIDON_25L
  BONBONNE_19L
}

enum LoyaltyTier {
  BRONZE
  ARGENT
  OR
  PLATINE
}

enum ProductionOrderStatus {
  PLANIFIE
  EN_COURS
  TERMINE
  BLOQUE
}

enum LotStatus {
  EN_PRODUCTION
  QUARANTAINE
  LIBERE
  BLOQUE
}

enum QualityCheckStatus {
  EN_ATTENTE
  CONFORME
  NON_CONFORME
}

enum PaymentMethod {
  ESPECES
  CHEQUE
  VIREMENT
  MOBILE_MONEY
  MPESA
  ORANGE_MONEY
  AIRTEL_MONEY
  WAVE
  CREDIT
}

enum OrderStatus {
  BROUILLON
  VALIDEE
  EN_PREPARATION
  CHARGEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum TourStatus {
  PLANIFIEE
  EN_CHARGEMENT
  EN_COURS
  TERMINEE
  ANNULEE
}

enum DeliveryStatus {
  EN_ATTENTE
  LIVREE
  REFUSEE
  PARTIELLE
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum StockLocationType {
  MATIERES_PREMIERES
  PRODUCTION
  BIDONS_A_TRIER
  BIDONS_LAVAGE
  BIDONS_LIBERES
  PRODUITS_FINIS
  VEHICULE
  QUARANTAINE
  RETRAITEMENT
  REPARATION
  REBUT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  toursAsDriver    Tour[]     @relation("TourDriver")
  deliveries       Delivery[]
  payments         Payment[]
  auditLogs        AuditLog[]
  syncEvents       SyncEvent[]
  shiftAssignments ShiftAssignment[]
  dailyReports     DailyActivityReport[]
  notifications    Notification[]
  employeeProfile  EmployeeProfile?
  leaveRequests    LeaveRequest[]    @relation("LeaveEmployee")
  leaveValidations LeaveRequest[]    @relation("LeaveValidator")
  payslips         Payslip[]
  payrollValidated PayrollPeriod[]   @relation("PayrollValidator")

  resolvedAnomalies Anomaly[]          @relation("AnomalyResolver")
  assistantSessions AssistantSession[] @relation("AssistantUser")
  securityAlerts    SecurityAlert[]    @relation("SecurityAlertUser")
  mfaCredential     MfaCredential?
  preference        UserPreference?
  savedViews        SavedView[]

  @@map("users")
}

model Client {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  segment         ClientSegment
  address         String?
  city            String?
  zone            String?
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  creditLimit     Decimal       @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditBalance   Decimal       @default(0) @map("credit_balance") @db.Decimal(12, 2)
  consigneLimit   Int           @default(50) @map("consigne_limit")
  consigneBalance Int           @default(0) @map("consigne_balance")
  loyaltyPoints   Int           @default(0) @map("loyalty_points")
  loyaltyTier     LoyaltyTier   @default(BRONZE) @map("loyalty_tier")
  walletBalance   Decimal       @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  orders     Order[]
  deliveries Delivery[]
  consignes  ConsigneMovement[]
  payments   Payment[]

  portalAccounts PortalAccount[]
  quoteRequests  QuoteRequest[]

  @@map("clients")
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  format      ProductFormat
  unitPrice   Decimal       @map("unit_price") @db.Decimal(12, 2)
  consigneAmount Decimal    @default(0) @map("consigne_amount") @db.Decimal(12, 2)
  isReusable  Boolean       @default(false) @map("is_reusable")
  maxRotations Int          @default(0) @map("max_rotations")
  loyaltyPointsPerUnit Int  @default(0) @map("loyalty_points_per_unit")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  stockItems  StockItem[]
  orderLines  OrderLine[]
  deliveryLines DeliveryLine[]
  forecasts   DemandForecast[]

  @@map("products")
}

model StockLocation {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  type      StockLocationType
  vehicleId String?           @map("vehicle_id")
  createdAt DateTime          @default(now()) @map("created_at")

  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id])
  stockItems StockItem[]

  @@map("stock_locations")
}

model StockItem {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  quantity   Int      @default(0)
  lotNumber  String?  @map("lot_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId, lotNumber])
  @@map("stock_items")
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String   @unique
  name      String
  capacity  Int      @default(100)
  fuelType  String   @default("DIESEL") @map("fuel_type")
  /// Facteur d'émission utilisé pour estimer l'empreinte carbone d'une tournée (EF-ESG-01).
  co2FactorKgPerKm Float @default(0.31) @map("co2_factor_kg_per_km")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tours     Tour[]
  locations StockLocation[]
  sensors   IotSensor[]

  @@map("vehicles")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  clientId    String      @map("client_id")
  status      OrderStatus @default(BROUILLON)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes       String?
  tourId      String?     @map("tour_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  client     Client      @relation(fields: [clientId], references: [id])
  tour       Tour?       @relation(fields: [tourId], references: [id])
  lines      OrderLine[]
  deliveries Delivery[]

  @@map("orders")
}

model OrderLine {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_lines")
}

model Tour {
  id          String     @id @default(uuid())
  tourNumber  String     @unique @map("tour_number")
  zone        String
  date        DateTime   @db.Date
  driverId    String     @map("driver_id")
  vehicleId   String     @map("vehicle_id")
  status      TourStatus @default(PLANIFIEE)
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  driver     User       @relation("TourDriver", fields: [driverId], references: [id])
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
  orders     Order[]
  deliveries Delivery[]
  loadSheets LoadSheet[]

  optimizedRoutes OptimizedRoute[]
  esgIndicators   EsgIndicator[]

  @@map("tours")
}

model LoadSheet {
  id              String   @id @default(uuid())
  tourId          String   @map("tour_id")
  validatedByStore Boolean @default(false) @map("validated_by_store")
  validatedByDriver Boolean @default(false) @map("validated_by_driver")
  items           Json
  createdAt       DateTime @default(now()) @map("created_at")

  tour Tour @relation(fields: [tourId], references: [id])

  @@map("load_sheets")
}

model Delivery {
  id              String         @id @default(uuid())
  deliveryNumber  String         @unique @map("delivery_number")
  orderId         String         @map("order_id")
  clientId        String         @map("client_id")
  tourId          String         @map("tour_id")
  driverId        String         @map("driver_id")
  status          DeliveryStatus @default(EN_ATTENTE)
  deliveredAt     DateTime?      @map("delivered_at")
  latitude        Float?
  longitude       Float?
  signatureUrl    String?        @map("signature_url")
  photoUrl        String?        @map("photo_url")
  clientCode      String?        @map("client_code")
  notes           String?
  localId         String?        @unique @map("local_id")
  syncStatus      SyncStatus     @default(SYNCED) @map("sync_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  order    Order          @relation(fields: [orderId], references: [id])
  client   Client         @relation(fields: [clientId], references: [id])
  tour     Tour           @relation(fields: [tourId], references: [id])
  driver   User           @relation(fields: [driverId], references: [id])
  lines    DeliveryLine[]
  payments Payment[]

  @@map("deliveries")
}

model DeliveryLine {
  id           String  @id @default(uuid())
  deliveryId   String  @map("delivery_id")
  productId    String  @map("product_id")
  qtyDelivered Int     @map("qty_delivered")
  qtyReturned  Int     @default(0) @map("qty_returned")
  qtyDamaged   Int     @default(0) @map("qty_damaged")
  qtyRefused   Int     @default(0) @map("qty_refused")
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("delivery_lines")
}

model ConsigneMovement {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  deliveryId  String?  @map("delivery_id")
  productFormat ProductFormat @map("product_format")
  qtyIn       Int      @default(0) @map("qty_in")
  qtyOut      Int      @default(0) @map("qty_out")
  balanceAfter Int     @map("balance_after")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])

  @@map("consigne_movements")
}

model Payment {
  id          String        @id @default(uuid())
  paymentNumber String      @unique @map("payment_number")
  deliveryId  String?       @map("delivery_id")
  clientId    String?       @map("client_id")
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  collectedBy String        @map("collected_by")
  localId     String?       @unique @map("local_id")
  syncStatus  SyncStatus    @default(SYNCED) @map("sync_status")
  createdAt   DateTime      @default(now()) @map("created_at")

  delivery  Delivery? @relation(fields: [deliveryId], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id])
  collector User      @relation(fields: [collectedBy], references: [id])

  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SyncEvent {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  deviceId   String     @map("device_id")
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id")
  localId    String     @map("local_id")
  payload    Json
  status     SyncStatus @default(PENDING)
  syncedAt   DateTime?  @map("synced_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sync_events")
}

model ProductionOrder {
  id            String                @id @default(uuid())
  orderNumber   String                @unique @map("order_number")
  lotNumber     String                @unique @map("lot_number")
  productFormat ProductFormat         @map("product_format")
  lineCode      String                @map("line_code")
  plannedQty    Int                   @map("planned_qty")
  producedQty   Int                   @default(0) @map("produced_qty")
  status        ProductionOrderStatus @default(PLANIFIE)
  lotStatus     LotStatus             @default(EN_PRODUCTION) @map("lot_status")
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  qualityChecks QualityCheck[]

  @@map("production_orders")
}

model QualityCheck {
  id                String             @id @default(uuid())
  productionOrderId String?            @map("production_order_id")
  lotNumber         String             @map("lot_number")
  ph                Float?
  chlorineFree      Float?             @map("chlorine_free")
  tds               Float?
  turbidity         Float?
  microbiologyOk    Boolean?           @map("microbiology_ok")
  status            QualityCheckStatus @default(EN_ATTENTE)
  validatedBy       String?            @map("validated_by")
  validatedAt       DateTime?          @map("validated_at")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")

  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@map("quality_checks")
}

model ShiftAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  postLabel String   @map("post_label")
  notes     String?
  validated Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("shift_assignments")
}

model DailyActivityReport {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        DateTime @db.Date
  activities  Json
  incidents   String?
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_activity_reports")
}

model FountainAsset {
  id           String   @id @default(uuid())
  serialNumber String   @unique @map("serial_number")
  clientId     String?  @map("client_id")
  model        String?
  contractType String?  @map("contract_type")
  lastService  DateTime? @map("last_service")
  nextService  DateTime? @map("next_service")
  fillLevelPct Float?    @map("fill_level_pct")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  sensors IotSensor[]

  @@map("fountain_assets")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

enum NotificationCategory {
  COMMANDE
  TOURNEE
  LIVRAISON
  PAIEMENT
  PRODUCTION
  QUALITE
  STOCK
  CONSIGNE
  FIDELITE
  RH
  SYSTEME
  SUPERVISION
  IA
  IOT
  ESG
  SECURITE
  PORTAIL
}

model Notification {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  title     String
  message   String
  type      NotificationType     @default(INFO)
  category  NotificationCategory @default(SYSTEME)
  link      String?
  read      Boolean              @default(false) @map("is_read")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model PackagingUnit {
  id              String        @id @default(uuid())
  barcode         String        @unique
  productFormat   ProductFormat @map("product_format")
  rotationCount   Int           @default(0) @map("rotation_count")
  maxRotations    Int           @map("max_rotations")
  status          String        @default("ACTIF")
  lastSanitizedAt DateTime?     @map("last_sanitized_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("packaging_units")
}

// ============================================================================
// v3.0 « Enterprise Smart & AI-Augmented »
// ============================================================================

enum SensorKind {
  QUALITE_LIGNE
  VEHICULE
  FONTAINE
}

enum SensorStatus {
  ACTIF
  HORS_LIGNE
  MAINTENANCE
}

enum AnomalyKind {
  STOCK
  CONSIGNE
  ENCAISSEMENT
  PRODUCTION
  CAPTEUR
}

enum AnomalySeverity {
  FAIBLE
  MOYENNE
  ELEVEE
  CRITIQUE
}

enum AnomalyStatus {
  OUVERTE
  EN_COURS
  RESOLUE
  IGNOREE
}

enum AssistantChannel {
  BACKOFFICE
  PORTAIL
  WHATSAPP
}

enum AssistantAuthor {
  UTILISATEUR
  ASSISTANT
}

enum SecurityAlertKind {
  ECHEC_AUTHENTIFICATION
  ACCES_REFUSE
  ELEVATION_PRIVILEGE
  ACTIVITE_ANORMALE
  CONFORMITE
}

enum SecurityAlertStatus {
  OUVERTE
  ANALYSEE
  CLOTUREE
}

enum EsgScope {
  TOURNEE
  SITE
}

/// Prévision de demande calculée par produit, zone et période (EF-IA-01).
model DemandForecast {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  zone         String
  horizonDate  DateTime @map("horizon_date") @db.Date
  forecastQty  Int      @map("forecast_qty")
  confidence   Float    @default(0)
  /// Facteurs explicatifs restitués à l'utilisateur (EF-IA-04).
  factors      Json
  modelVersion String   @map("model_version")
  generatedAt  DateTime @default(now()) @map("generated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, zone, horizonDate])
  @@index([zone, horizonDate])
  @@map("demand_forecasts")
}

/// Anomalie signalée par le moteur d'analyse, avec son niveau de confiance (EF-IA-02).
model Anomaly {
  id           String          @id @default(uuid())
  kind         AnomalyKind
  severity     AnomalySeverity @default(MOYENNE)
  status       AnomalyStatus   @default(OUVERTE)
  entityType   String          @map("entity_type")
  entityId     String?         @map("entity_id")
  title        String
  description  String
  score        Float           @default(0)
  factors      Json
  detectedAt   DateTime        @default(now()) @map("detected_at")
  resolvedAt   DateTime?       @map("resolved_at")
  resolvedById String?         @map("resolved_by_id")

  resolvedBy User? @relation("AnomalyResolver", fields: [resolvedById], references: [id])

  @@index([status, severity])
  @@map("anomalies")
}

/// Score de risque de panne par équipement (EF-IA-03).
model MaintenanceRisk {
  id                String   @id @default(uuid())
  equipmentCode     String   @map("equipment_code")
  lineCode          String   @map("line_code")
  riskScore         Float    @map("risk_score")
  factors           Json
  predictedFailureAt DateTime? @map("predicted_failure_at")
  computedAt        DateTime @default(now()) @map("computed_at")

  @@unique([equipmentCode, computedAt])
  @@index([equipmentCode])
  @@map("maintenance_risks")
}

/// Journal de performance des modèles, réentraînement inclus (EF-IA-05).
model ModelRun {
  id           String   @id @default(uuid())
  modelName    String   @map("model_name")
  modelVersion String   @map("model_version")
  samples      Int      @default(0)
  /// Écart absolu moyen en pourcentage, mesuré sur l'historique.
  mapePct      Float?   @map("mape_pct")
  metrics      Json
  ranAt        DateTime @default(now()) @map("ran_at")

  @@index([modelName, ranAt])
  @@map("model_runs")
}

/// Session d'échange avec l'assistant conversationnel (EF-BOT-04).
model AssistantSession {
  id              String           @id @default(uuid())
  channel         AssistantChannel @default(BACKOFFICE)
  userId          String?          @map("user_id")
  portalAccountId String?          @map("portal_account_id")
  escalated       Boolean          @default(false)
  escalatedAt     DateTime?        @map("escalated_at")
  startedAt       DateTime         @default(now()) @map("started_at")
  lastMessageAt   DateTime         @default(now()) @map("last_message_at")

  user          User?             @relation("AssistantUser", fields: [userId], references: [id])
  portalAccount PortalAccount?    @relation(fields: [portalAccountId], references: [id])
  messages      AssistantMessage[]

  @@index([userId, startedAt])
  @@map("assistant_sessions")
}

model AssistantMessage {
  id         String          @id @default(uuid())
  sessionId  String          @map("session_id")
  author     AssistantAuthor
  content    String
  intent     String?
  confidence Float?
  createdAt  DateTime        @default(now()) @map("created_at")

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("assistant_messages")
}

/// Capteur rattaché à une machine, un véhicule ou une fontaine (EF-IOT-01 à 03).
model IotSensor {
  id          String       @id @default(uuid())
  code        String       @unique
  label       String
  kind        SensorKind
  metric      String
  unit        String
  minValue    Float?       @map("min_value")
  maxValue    Float?       @map("max_value")
  machineCode String?      @map("machine_code")
  lineCode    String?      @map("line_code")
  vehicleId   String?      @map("vehicle_id")
  fountainId  String?      @map("fountain_id")
  status      SensorStatus @default(ACTIF)
  lastSeenAt  DateTime?    @map("last_seen_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  vehicle  Vehicle?        @relation(fields: [vehicleId], references: [id])
  fountain FountainAsset?  @relation(fields: [fountainId], references: [id])
  readings SensorReading[]

  @@index([kind, status])
  @@map("iot_sensors")
}

model SensorReading {
  id         String   @id @default(uuid())
  sensorId   String   @map("sensor_id")
  value      Float
  outOfRange Boolean  @default(false) @map("out_of_range")
  recordedAt DateTime @default(now()) @map("recorded_at")

  sensor IotSensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, recordedAt])
  @@map("sensor_readings")
}

/// Séquence de points de livraison proposée par l'optimiseur (EF-OPT-01 à 03).
model OptimizedRoute {
  id                 String    @id @default(uuid())
  tourId             String    @map("tour_id")
  /// Ordre de passage : [{ order, clientId, clientName, latitude, longitude, priority }].
  stops              Json
  totalDistanceKm    Float     @map("total_distance_km")
  estimatedDurationMin Int     @map("estimated_duration_min")
  algorithm          String
  manuallyAdjusted   Boolean   @default(false) @map("manually_adjusted")
  appliedAt          DateTime? @map("applied_at")
  actualDistanceKm   Float?    @map("actual_distance_km")
  deviationPct       Float?    @map("deviation_pct")
  generatedAt        DateTime  @default(now()) @map("generated_at")

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, generatedAt])
  @@map("optimized_routes")
}

/// Mesure de durabilité rattachée à une période et à une tournée ou un site (EF-ESG-01, 02).
model EsgIndicator {
  id            String   @id @default(uuid())
  scope         EsgScope @default(TOURNEE)
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  tourId        String?  @map("tour_id")
  distanceKm    Float    @default(0) @map("distance_km")
  co2Kg         Float    @default(0) @map("co2_kg")
  waterM3       Float    @default(0) @map("water_m3")
  energyKwh     Float    @default(0) @map("energy_kwh")
  reusePct      Float    @default(0) @map("reuse_pct")
  computedAt    DateTime @default(now()) @map("computed_at")

  tour Tour? @relation(fields: [tourId], references: [id])

  @@index([scope, periodStart])
  @@map("esg_indicators")
}

/// Accès self-service du client, distinct du compte utilisateur interne (EF-PC-01).
model PortalAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  clientId     String    @map("client_id")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assistantSessions AssistantSession[]

  @@index([clientId])
  @@map("portal_accounts")
}

/// Alerte centralisée du centre de sécurité (ESE-12).
model SecurityAlert {
  id        String              @id @default(uuid())
  kind      SecurityAlertKind
  severity  AnomalySeverity     @default(MOYENNE)
  status    SecurityAlertStatus @default(OUVERTE)
  source    String
  message   String
  email     String?
  ipAddress String?             @map("ip_address")
  userId    String?             @map("user_id")
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  user User? @relation("SecurityAlertUser", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("security_alerts")
}

/// Second facteur d'authentification par code temporaire (ESE-08).
model MfaCredential {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  secret     String
  confirmed  Boolean   @default(false)
  confirmedAt DateTime? @map("confirmed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_credentials")
}

/// Préférences d'affichage : thème et disposition du tableau de bord (EX-IHM-13, 14).
model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  theme           String   @default("clair")
  /// Ordre et visibilité des panneaux : [{ key, visible }].
  dashboardLayout Json?    @map("dashboard_layout")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum QuoteRequestStatus {
  NOUVELLE
  EN_NEGOCIATION
  ACCEPTEE
  REFUSEE
}

/// Clé d'accès à l'API publique pour un partenaire (canal « API publique et webhooks »).
model ApiKey {
  id         String    @id @default(uuid())
  label      String
  partner    String
  keyPrefix  String    @unique @map("key_prefix")
  keyHash    String    @map("key_hash")
  scopes     String[]
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

/// Abonnement d'un partenaire aux événements métier diffusés par le bus interne.
model WebhookSubscription {
  id        String   @id @default(uuid())
  label     String
  url       String
  events    String[]
  secret    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  subscriptionId String    @map("subscription_id")
  event          String
  payload        Json
  statusCode     Int?      @map("status_code")
  error          String?
  attempts       Int       @default(0)
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

/// Demande de cotation issue de la marketplace B2B (grossistes et détaillants).
model QuoteRequest {
  id           String             @id @default(uuid())
  reference    String             @unique
  clientId     String?            @map("client_id")
  companyName  String             @map("company_name")
  contactEmail String             @map("contact_email")
  contactPhone String?            @map("contact_phone")
  segment      ClientSegment      @default(DETAILLANT)
  zone         String?
  /// Lignes souhaitées : [{ productId, productName, quantity }].
  lines        Json
  message      String?
  status       QuoteRequestStatus @default(NOUVELLE)
  quotedAmount Decimal?           @map("quoted_amount") @db.Decimal(12, 2)
  handledById  String?            @map("handled_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id])

  @@index([status, createdAt])
  @@map("quote_requests")
}

/// Vue sauvegardée et filtres favoris par utilisateur (EX-IHM-16).
model SavedView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  resource  String
  name      String
  filters   Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, name])
  @@map("saved_views")
}

enum ContractType {
  CDI
  CDD
  STAGE
  PRESTATION
  JOURNALIER
}

enum EmployeeStatus {
  ACTIF
  SUSPENDU
  SORTI
}

enum LeaveType {
  CONGE_PAYE
  MALADIE
  SANS_SOLDE
  AUTORISATION
  MATERNITE
}

enum LeaveStatus {
  BROUILLON
  SOUMISE
  VALIDEE
  REJETEE
  ANNULEE
}

enum PayrollPeriodStatus {
  BROUILLON
  CALCULEE
  VALIDEE
  CLOTUREE
}

enum PayslipStatus {
  BROUILLON
  VALIDEE
  PAYEE
}

/// Dossier administratif d'un agent (contrat, salaire de base, affiliation CNSS).
model EmployeeProfile {
  id          String         @id @default(uuid())
  userId      String         @unique @map("user_id")
  matricule   String         @unique
  jobTitle    String         @map("job_title")
  department  String
  contractType ContractType  @default(CDI) @map("contract_type")
  hireDate    DateTime       @map("hire_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  baseSalary  Decimal        @map("base_salary") @db.Decimal(12, 2)
  currency    String         @default("CDF")
  bankName    String?        @map("bank_name")
  bankAccount String?        @map("bank_account")
  cnssNumber  String?        @map("cnss_number")
  nif         String?
  status      EmployeeStatus @default(ACTIF)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@map("employee_profiles")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  type          LeaveType
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  days          Int
  reason        String?
  status        LeaveStatus @default(SOUMISE)
  validatedById String?     @map("validated_by_id")
  validatedAt   DateTime?   @map("validated_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user        User  @relation("LeaveEmployee", fields: [userId], references: [id], onDelete: Cascade)
  validatedBy User? @relation("LeaveValidator", fields: [validatedById], references: [id])

  @@index([userId, startDate])
  @@map("leave_requests")
}

model PayrollPeriod {
  id            String               @id @default(uuid())
  year          Int
  month         Int
  status        PayrollPeriodStatus  @default(BROUILLON)
  expectedDays  Int                  @default(26) @map("expected_days")
  generatedAt   DateTime?            @map("generated_at")
  validatedAt   DateTime?            @map("validated_at")
  validatedById String?              @map("validated_by_id")
  closedAt      DateTime?            @map("closed_at")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")

  validatedBy User?     @relation("PayrollValidator", fields: [validatedById], references: [id])
  payslips    Payslip[]

  @@unique([year, month])
  @@map("payroll_periods")
}

model Payslip {
  id                String        @id @default(uuid())
  periodId          String        @map("period_id")
  userId            String        @map("user_id")
  employeeProfileId String?       @map("employee_profile_id")
  baseSalary        Decimal       @map("base_salary") @db.Decimal(12, 2)
  workedDays        Int           @map("worked_days")
  overtimeHours     Decimal       @default(0) @map("overtime_hours") @db.Decimal(8, 2)
  overtimeAmount    Decimal       @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  bonuses           Decimal       @default(0) @db.Decimal(12, 2)
  deductions        Decimal       @default(0) @db.Decimal(12, 2)
  cnssEmployee      Decimal       @default(0) @map("cnss_employee") @db.Decimal(12, 2)
  iprf              Decimal       @default(0) @db.Decimal(12, 2)
  grossPay          Decimal       @map("gross_pay") @db.Decimal(12, 2)
  netPay            Decimal       @map("net_pay") @db.Decimal(12, 2)
  status            PayslipStatus @default(BROUILLON)
  paidAt            DateTime?     @map("paid_at")
  paymentReference  String?       @map("payment_reference")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  period   PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee EmployeeProfile? @relation(fields: [employeeProfileId], references: [id])

  @@unique([periodId, userId])
  @@map("payslips")
}
