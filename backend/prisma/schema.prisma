  managerId     String?     @map("manager_id")
  managerAt     DateTime?   @map("manager_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user        User  @relation("LeaveEmployee", fields: [userId], references: [id], onDelete: Cascade)
  validatedBy User? @relation("LeaveValidator", fields: [validatedById], references: [id])
  manager     User? @relation("LeaveManager", fields: [managerId], references: [id])

  @@index([userId, startDate])
  @@map("leave_requests")
}

model PayrollPeriod {
  id            String               @id @default(uuid())
  year          Int
  month         Int
  status        PayrollPeriodStatus  @default(BROUILLON)
  expectedDays  Int                  @default(26) @map("expected_days")
  generatedAt   DateTime?            @map("generated_at")
  validatedAt   DateTime?            @map("validated_at")
  validatedById String?              @map("validated_by_id")
  closedAt      DateTime?            @map("closed_at")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")

  validatedBy User?     @relation("PayrollValidator", fields: [validatedById], references: [id])
  payslips    Payslip[]

  @@unique([year, month])
  @@map("payroll_periods")
}

model Payslip {
  id                String        @id @default(uuid())
  periodId          String        @map("period_id")
  userId            String        @map("user_id")
  employeeProfileId String?       @map("employee_profile_id")
  baseSalary        Decimal       @map("base_salary") @db.Decimal(12, 2)
  workedDays        Int           @map("worked_days")
  overtimeHours     Decimal       @default(0) @map("overtime_hours") @db.Decimal(8, 2)
  overtimeAmount    Decimal       @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  bonuses           Decimal       @default(0) @db.Decimal(12, 2)
  deductions        Decimal       @default(0) @db.Decimal(12, 2)
  cnssEmployee      Decimal       @default(0) @map("cnss_employee") @db.Decimal(12, 2)
  iprf              Decimal       @default(0) @db.Decimal(12, 2)
  grossPay          Decimal       @map("gross_pay") @db.Decimal(12, 2)
  netPay            Decimal       @map("net_pay") @db.Decimal(12, 2)
  status            PayslipStatus @default(BROUILLON)
  paidAt            DateTime?     @map("paid_at")
  paymentReference  String?       @map("payment_reference")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  period   PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee EmployeeProfile? @relation(fields: [employeeProfileId], references: [id])

  @@unique([periodId, userId])
  @@map("payslips")
}

model JobFunction {
  id          String   @id @default(uuid())
  name        String   @unique
  department  String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  activities JobFunctionActivity[]
  employees  EmployeeProfile[]

  @@map("job_functions")
}

model JobFunctionActivity {
  id          String   @id @default(uuid())
  functionId  String   @map("function_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  jobFunction   JobFunction            @relation(fields: [functionId], references: [id], onDelete: Cascade)
  declarations  ActivityDeclaration[]
  objectives    AgentActivityObjective[]

  @@map("job_function_activities")
}

model ActivityDeclaration {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  activityId        String?     @map("activity_id")
  date              DateTime    @db.Date
  comment           String?
  attachmentUrl     String?     @map("attachment_url") @db.Text
  status            LeaveStatus @default(SOUMISE)
  validatedById     String?     @map("validated_by_id")
  validatedAt       DateTime?   @map("validated_at")
  rejectionReason   String?     @map("rejection_reason")
  createdAt         DateTime    @default(now()) @map("created_at")

  user      User                  @relation("ActivityDeclarant", fields: [userId], references: [id], onDelete: Cascade)
  activity  JobFunctionActivity?  @relation(fields: [activityId], references: [id])
  validator User?                 @relation("ActivityValidator", fields: [validatedById], references: [id])

  @@index([userId, date])
  @@map("activity_declarations")
}

model PerformanceObjective {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  periodType  String   @default("ANNUEL") @map("period_type")
  year        Int
  quarter     Int?
  weight      Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
  @@map("performance_objectives")
}

/// Objectif chiffre lie a une activite de fonction (module Objectifs agents).
model AgentActivityObjective {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  activityId  String   @map("activity_id")
  title       String
  periodType  String   @default("MENSUEL") @map("period_type")
  year        Int
  month       Int?
  quarter     Int?
  targetValue Decimal  @map("target_value") @db.Decimal(14, 2)
  unit        String   @default("DECLARATION")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity JobFunctionActivity  @relation(fields: [activityId], references: [id])

  @@index([userId, year])
  @@index([activityId, year])
  @@map("agent_activity_objectives")
}

model PerformanceReview {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  year               Int
  period             String
  selfScores         Json?        @map("self_scores")
  managerScores      Json?        @map("manager_scores")
  selfComment        String?      @map("self_comment")
  managerComment     String?      @map("manager_comment")
  selfSubmittedAt    DateTime?    @map("self_submitted_at")
  managerValidatedAt DateTime?    @map("manager_validated_at")
  managerId          String?      @map("manager_id")
  finalScore         Decimal?     @map("final_score") @db.Decimal(5, 2)
  status             ReviewStatus @default(BROUILLON)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user    User  @relation("ReviewEmployee", fields: [userId], references: [id], onDelete: Cascade)
  manager User? @relation("ReviewManager", fields: [managerId], references: [id])

  @@unique([userId, year, period])
  @@map("performance_reviews")
}

model TrainingCourse {
  id        String        @id @default(uuid())
  title     String
  kind      TrainingKind  @default(INTERNE)
  provider  String?
  location  String?
  startDate DateTime?     @map("start_date") @db.Date
  endDate   DateTime?     @map("end_date") @db.Date
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")

  enrollments TrainingEnrollment[]

  @@map("training_courses")
}

model TrainingEnrollment {
  id              String                    @id @default(uuid())
  courseId        String                    @map("course_id")
  userId          String                    @map("user_id")
  status          TrainingEnrollmentStatus  @default(INSCRITE)
  certificateUrl  String?                   @map("certificate_url") @db.Text
  validatedById   String?                   @map("validated_by_id")
  rejectionReason String?                   @map("rejection_reason")
  createdAt       DateTime                  @default(now()) @map("created_at")

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("training_enrollments")
}

model EmployeeDocument {
  id         String         @id @default(uuid())
  employeeId String         @map("employee_id")
  type       HrDocumentType
  title      String
  fileUrl    String?        @map("file_url") @db.Text
  issuedAt   DateTime?      @map("issued_at") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type])
  @@map("employee_documents")
}

model EmployeeFieldHistory {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  field      String
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  actorId    String   @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actor    User            @relation("HistoryActor", fields: [actorId], references: [id])

  @@index([employeeId, createdAt])
  @@map("employee_field_history")
}

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String?
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  nif         String?
  rccm        String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contracts Contract[]

  @@map("suppliers")
}

/// Contrats d'agents, de fournisseurs et de grands comptes.
model Contract {
  id                String               @id @default(uuid())
  reference         String               @unique
  partyKind         ContractPartyKind    @map("party_kind")
  title             String
  kind              BusinessContractKind
  status            ContractLifecycle    @default(BROUILLON)
  startDate         DateTime             @map("start_date") @db.Date
  endDate           DateTime?            @map("end_date") @db.Date
  noticeDays        Int                  @default(30) @map("notice_days")
  autoRenew         Boolean              @default(false) @map("auto_renew")
  currency          String               @default("CDF")
  amount            Decimal?             @db.Decimal(14, 2)
  paymentTerms      String?              @map("payment_terms")
  billingCycle      String?              @map("billing_cycle")
  volumeCommitment  String?              @map("volume_commitment")
  territory         String?
  exclusivity       Boolean              @default(false)
  clauses           String?              @db.Text
  notes             String?              @db.Text
  documentUrl       String?              @map("document_url") @db.Text
  signedAt          DateTime?            @map("signed_at")
  signedByParty     String?              @map("signed_by_party")
  signedByCompany   String?              @map("signed_by_company")
  employeeId        String?              @map("employee_id")
  supplierId        String?              @map("supplier_id")
  clientId          String?              @map("client_id")
  validatedById     String?              @map("validated_by_id")
  validatedAt       DateTime?            @map("validated_at")
  terminatedAt      DateTime?            @map("terminated_at")
  terminateReason   String?              @map("terminate_reason")
  renewalCount      Int                  @default(0) @map("renewal_count")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  employee    EmployeeProfile?     @relation(fields: [employeeId], references: [id])
  supplier    Supplier?            @relation(fields: [supplierId], references: [id])
  client      Client?              @relation(fields: [clientId], references: [id])
  validatedBy User?                @relation("ContractValidator", fields: [validatedById], references: [id])
  amendments  ContractAmendment[]
  documents   ContractDocument[]
  template    ContractTemplate?    @relation(fields: [templateId], references: [id])
  templateId  String?              @map("template_id")

  @@index([partyKind, status])
  @@index([endDate])
  @@map("contracts")
}

model ContractAmendment {
  id         String   @id @default(uuid())
  contractId String   @map("contract_id")
  reference  String
  reason     String
  amount     Decimal? @db.Decimal(14, 2)
  startDate  DateTime @map("start_date") @db.Date
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_amendments")
}

model ContractTemplate {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  partyKind   ContractPartyKind?     @map("party_kind")
  kind        BusinessContractKind?
  title       String
  body        String                 @db.Text
  clauses     String?                @db.Text
  footer      String?                @db.Text
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  contracts Contract[]
  documents ContractDocument[]

  @@index([partyKind, kind])
  @@map("contract_templates")
}

model ContractDocument {
  id           String               @id @default(uuid())
  contractId   String               @map("contract_id")
  templateId   String?              @map("template_id")
  kind         ContractDocumentKind
  filename     String
  mimeType     String               @map("mime_type")
  byteSize     Int                  @map("byte_size")
  content      Bytes
  generatedAt  DateTime             @default(now()) @map("generated_at")
  archivedAt   DateTime?            @map("archived_at")
  archivedById String?              @map("archived_by_id")
  notes        String?

  contract   Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  template   ContractTemplate? @relation(fields: [templateId], references: [id])
  archivedBy User?             @relation("ContractArchiver", fields: [archivedById], references: [id])

  @@index([contractId, kind])
  @@index([archivedAt])
  @@map("contract_documents")
}

/// Matrice d'habilitations par profil (CRUDVN) sur chaque module / menu.
model RolePermission {
  id        String   @id @default(uuid())
  role      UserRole
  resource  String
  actions   String[]
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, resource])
  @@index([role])
  @@map("role_permissions")
}

/// Exceptions individuelles : GRANT ajoute un droit, DENY le retire.
model UserPermission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  resource  String
  action    String
  effect    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@index([userId])
  @@map("user_permissions")
}

enum FinanceAccountKind {
  CAISSE
  BANQUE
}

enum FinanceCategoryKind {
  RECETTE
  CHARGE
  TRANSFERT
}

enum FinanceMovementKind {
  ENTREE
  SORTIE
  TRANSFERT
  DEPENSE
  ENCAISSEMENT
}

enum FinanceMovementStatus {
  BROUILLON
  VALIDE
  ANNULE
}

enum FinanceInventoryStatus {
  BROUILLON
  VALIDE
  ANNULE
}

/// Compte de tresorerie : caisse especes ou compte bancaire.
model FinanceAccount {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  kind           FinanceAccountKind
  currency       String             @default("CDF")
  openingBalance Decimal            @default(0) @map("opening_balance") @db.Decimal(14, 2)
  bankName       String?            @map("bank_name")
  iban           String?
  isActive       Boolean            @default(true) @map("is_active")
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  createdBy    User?             @relation("FinanceAccountCreator", fields: [createdById], references: [id])
  movementsIn  FinanceMovement[] @relation("FinanceAccountSource")
  movementsOut FinanceMovement[] @relation("FinanceAccountDest")

  @@index([kind, isActive])
  @@map("finance_accounts")
}

/// Rubrique budgetaire / analytique (recette ou charge).
model FinanceCategory {
  id        String              @id @default(uuid())
  code      String              @unique
  name      String
  kind      FinanceCategoryKind
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")

  movements FinanceMovement[]
  budgets   FinanceBudget[]

  @@index([kind, isActive])
  @@map("finance_categories")
}

/// Entree, sortie, transfert, depense ou encaissement de fonds.
model FinanceMovement {
  id            String                 @id @default(uuid())
  number        String                 @unique
  kind          FinanceMovementKind
  status        FinanceMovementStatus  @default(BROUILLON)
  accountId     String                 @map("account_id")
  destAccountId String?                @map("dest_account_id")
  categoryId    String?                @map("category_id")
  paymentId     String?                @unique @map("payment_id")
  amount        Decimal                @db.Decimal(14, 2)
  method        PaymentMethod          @default(ESPECES)
  date          DateTime               @db.Date
  label         String
  reference     String?
  notes         String?
  createdById   String                 @map("created_by_id")
  validatedById String?                @map("validated_by_id")
  validatedAt   DateTime?              @map("validated_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  account     FinanceAccount    @relation("FinanceAccountSource", fields: [accountId], references: [id])
  destAccount FinanceAccount?   @relation("FinanceAccountDest", fields: [destAccountId], references: [id])
  category    FinanceCategory?  @relation(fields: [categoryId], references: [id])
  payment     Payment?          @relation(fields: [paymentId], references: [id])
  createdBy   User              @relation("FinanceMovementCreator", fields: [createdById], references: [id])
  validatedBy User?             @relation("FinanceMovementValidator", fields: [validatedById], references: [id])

  @@index([date, status])
  @@index([accountId, status])
  @@index([kind, status])
  @@map("finance_movements")
}

/// Enveloppe budgetaire annuelle ou mensuelle par rubrique.
model FinanceBudget {
  id            String   @id @default(uuid())
  year          Int
  month         Int?
  categoryId    String   @map("category_id")
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category FinanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([year, month, categoryId])
  @@index([year, month])
  @@map("finance_budgets")
}

/// Session d'inventaire physique valorisee.
model FinanceInventory {
  id            String                  @id @default(uuid())
  number        String                  @unique
  date          DateTime                @db.Date
  status        FinanceInventoryStatus  @default(BROUILLON)
  notes         String?
  createdById   String                  @map("created_by_id")
  validatedById String?                 @map("validated_by_id")
  validatedAt   DateTime?               @map("validated_at")
  createdAt     DateTime                @default(now()) @map("created_at")

  createdBy   User                    @relation("FinanceInventoryCreator", fields: [createdById], references: [id])
  validatedBy User?                   @relation("FinanceInventoryValidator", fields: [validatedById], references: [id])
  lines       FinanceInventoryLine[]

  @@index([date, status])
  @@map("finance_inventories")
}

model FinanceInventoryLine {
  id              String @id @default(uuid())
  inventoryId     String @map("inventory_id")
  productId       String @map("product_id")
  locationId      String @map("location_id")
  theoreticalQty  Int    @map("theoretical_qty")
  countedQty      Int    @map("counted_qty")
  unitValue       Decimal @map("unit_value") @db.Decimal(12, 2)

  inventory FinanceInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])

  @@index([inventoryId])
  @@map("finance_inventory_lines")
}
