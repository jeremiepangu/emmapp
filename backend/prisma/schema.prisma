generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DG
  CHEF_PRODUCTION
  CHEF_EXPLOITATION
  CHARGE_EXPLOITATION
  RESP_QUALITE
  MAGASINIER
  AGENT_CHARGEUR
  LIVREUR
  CHARGE_LIVRAISON
  COMMERCIAL
  DELEGUE_COMMERCIAL
  CAISSIER
  COMPTABLE
  RH
  SUPERVISEUR
  IT_GED
  DATA_ANALYST
  RESP_SECURITE
  RESP_DURABILITE
}

enum ClientSegment {
  PARTICULIER
  BOUTIQUE
  DETAILLANT
  SUPERMARCHE
  ENTREPRISE
  HOTEL_RESTAURANT
}

enum ProductFormat {
  BIDON_5L
  BIDON_10L
  BIDON_25L
  BONBONNE_19L
}

enum PricingRuleType {
  ARTICLE_OFFERT
  FIXED
}

enum ConsigneMovementSource {
  LIVRAISON
  POS
  COMMANDE
  RETOUR
  AJUSTEMENT
}

enum OrderPaymentStatus {
  IMPAYEE
  PARTIELLE
  SOLDEE
}

enum DiscrepancyKind {
  CAISSE
  TOURNEE
  VIDANGE
}

enum DiscrepancyStatus {
  OUVERT
  JUSTIFIE
  REGULARISE
}

enum CashClosingStatus {
  OUVERTE
  CLOTUREE
  VALIDEE
}

enum LoyaltyTier {
  BRONZE
  ARGENT
  OR
  PLATINE
}

enum ProductionOrderStatus {
  PLANIFIE
  EN_COURS
  TERMINE
  BLOQUE
}

enum LotStatus {
  EN_PRODUCTION
  QUARANTAINE
  LIBERE
  BLOQUE
}

enum QualityCheckStatus {
  EN_ATTENTE
  CONFORME
  NON_CONFORME
}

enum PaymentMethod {
  ESPECES
  CHEQUE
  VIREMENT
  MOBILE_MONEY
  MPESA
  ORANGE_MONEY
  AIRTEL_MONEY
  WAVE
  CREDIT
}

enum OrderStatus {
  BROUILLON
  VALIDEE
  EN_PREPARATION
  CHARGEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum PosSaleStatus {
  PAYEE
  ANNULEE
}

enum TourStatus {
  PLANIFIEE
  EN_CHARGEMENT
  EN_COURS
  TERMINEE
  ANNULEE
}

enum DeliveryStatus {
  EN_ATTENTE
  LIVREE
  REFUSEE
  PARTIELLE
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum StockLocationType {
  MATIERES_PREMIERES
  PRODUCTION
  BIDONS_A_TRIER
  BIDONS_LAVAGE
  BIDONS_LIBERES
  PRODUITS_FINIS
  VEHICULE
  QUARANTAINE
  RETRAITEMENT
  REPARATION
  REBUT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  toursAsDriver    Tour[]     @relation("TourDriver")
  deliveries       Delivery[]
  payments         Payment[]
  auditLogs        AuditLog[]
  syncEvents       SyncEvent[]
  shiftAssignments ShiftAssignment[]
  dailyReports     DailyActivityReport[]
  notifications    Notification[]
  employeeProfile  EmployeeProfile?
  managedEmployees EmployeeProfile[] @relation("EmployeeManager")
  leaveRequests    LeaveRequest[]    @relation("LeaveEmployee")
  leaveValidations LeaveRequest[]    @relation("LeaveValidator")
  leaveManagerDecisions LeaveRequest[] @relation("LeaveManager")
  payslips         Payslip[]
  payrollValidated PayrollPeriod[]   @relation("PayrollValidator")

  resolvedAnomalies Anomaly[]          @relation("AnomalyResolver")
  assistantSessions AssistantSession[] @relation("AssistantUser")
  securityAlerts    SecurityAlert[]    @relation("SecurityAlertUser")
  mfaCredential     MfaCredential?
  preference        UserPreference?
  savedViews        SavedView[]
  pricingRules      PricingRule[] @relation("PricingRuleDriver")
  activityDeclarations ActivityDeclaration[] @relation("ActivityDeclarant")
  activityValidations  ActivityDeclaration[] @relation("ActivityValidator")
  objectives           PerformanceObjective[]
  activityObjectives   AgentActivityObjective[]
  reviews              PerformanceReview[] @relation("ReviewEmployee")
  reviewValidations    PerformanceReview[] @relation("ReviewManager")
  trainingEnrollments  TrainingEnrollment[]
  packagingMovements   PackagingMovement[]
  hrFieldChanges       EmployeeFieldHistory[] @relation("HistoryActor")
  aclOverrides         UserPermission[]
  contractsValidated   Contract[]            @relation("ContractValidator")
  cashClosings         CashClosing[]         @relation("CashClosingCashier")
  resolvedDiscrepancies Discrepancy[]        @relation("DiscrepancyResolver")
  contractArchives     ContractDocument[]    @relation("ContractArchiver")
  posSales             PosSale[]             @relation("PosCashier")
  financeAccountsCreated     FinanceAccount[]    @relation("FinanceAccountCreator")
  financeMovementsCreated    FinanceMovement[]   @relation("FinanceMovementCreator")
  financeMovementsValidated  FinanceMovement[]   @relation("FinanceMovementValidator")
  financeInventoriesCreated  FinanceInventory[]  @relation("FinanceInventoryCreator")
  financeInventoriesValidated FinanceInventory[] @relation("FinanceInventoryValidator")

  @@map("users")
}

model Client {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  segment         ClientSegment
  address         String?
  avenue          String?
  avenueNumber    String?       @map("avenue_number")
  quartier        String?
  commune         String?
  district        String?
  province        String        @default("KINSHASA")
  city            String?
  zone            String?
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  idDocumentType  String?       @map("id_document_type")
  idDocumentNumber String?      @map("id_document_number")
  logoUrl         String?       @map("logo_url") @db.Text
  profession      String?
  creditLimit     Decimal       @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditBalance   Decimal       @default(0) @map("credit_balance") @db.Decimal(12, 2)
  consigneLimit   Int           @default(50) @map("consigne_limit")
  consigneBalance Int           @default(0) @map("consigne_balance")
  loyaltyPoints   Int           @default(0) @map("loyalty_points")
  loyaltyTier     LoyaltyTier   @default(BRONZE) @map("loyalty_tier")
  walletBalance   Decimal       @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  orders     Order[]
  deliveries Delivery[]
  consignes  ConsigneMovement[]
  consigneBalances ClientConsigneBalance[]
  payments   Payment[]
  posSales   PosSale[]
  discrepancies Discrepancy[]

  portalAccounts PortalAccount[]
  quoteRequests  QuoteRequest[]
  pricingRules   PricingRule[]
  contracts      Contract[]

  @@map("clients")
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  format      ProductFormat
  unitPrice   Decimal       @map("unit_price") @db.Decimal(12, 2)
  consigneAmount Decimal    @default(0) @map("consigne_amount") @db.Decimal(12, 2)
  isReusable  Boolean       @default(false) @map("is_reusable")
  imageUrl    String?       @map("image_url") @db.Text
  maxRotations Int          @default(0) @map("max_rotations")
  loyaltyPointsPerUnit Int  @default(0) @map("loyalty_points_per_unit")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  stockItems  StockItem[]
  orderLines  OrderLine[]
  deliveryLines DeliveryLine[]
  forecasts   DemandForecast[]
  pricingRules PricingRule[]
  posSaleLines PosSaleLine[]
  financeInventoryLines FinanceInventoryLine[]

  @@map("products")
}

model PricingRule {
  id          String           @id @default(uuid())
  name        String
  segment     ClientSegment?
  clientId    String?          @map("client_id")
  zone        String?
  driverId    String?          @map("driver_id")
  productId   String?          @map("product_id")
  minQuantity  Int              @default(1) @map("min_quantity")
  maxQuantity  Int?             @map("max_quantity")
  /// Taille du lot ouvrant droit au bonus (ex. 10 = 1 article offert tous les 10 achetes).
  stepQuantity Int              @default(10) @map("step_quantity")
  type         PricingRuleType  @default(ARTICLE_OFFERT)
  /// ARTICLE_OFFERT : nombre d'articles offerts par lot. FIXED : prix unitaire impose.
  value        Decimal          @db.Decimal(12, 2)
  priority    Int              @default(0)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  driver  User?    @relation("PricingRuleDriver", fields: [driverId], references: [id])

  @@index([segment, isActive])
  @@index([clientId, isActive])
  @@index([driverId, isActive])
  @@map("pricing_rules")
}

model StockLocation {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  type      StockLocationType
  vehicleId String?           @map("vehicle_id")
  createdAt DateTime          @default(now()) @map("created_at")

  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id])
  stockItems StockItem[]

  @@map("stock_locations")
}

model StockItem {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  quantity   Int      @default(0)
  lotNumber  String?  @map("lot_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId, lotNumber])
  @@map("stock_items")
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String   @unique
  name      String
  capacity  Int      @default(100)
  fuelType  String   @default("DIESEL") @map("fuel_type")
  /// Facteur d'émission utilisé pour estimer l'empreinte carbone d'une tournée (EF-ESG-01).
  co2FactorKgPerKm Float @default(0.31) @map("co2_factor_kg_per_km")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tours     Tour[]
  locations StockLocation[]
  sensors   IotSensor[]

  @@map("vehicles")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  clientId    String      @map("client_id")
  status      OrderStatus @default(BROUILLON)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  /// Part de consigne facturee comprise dans le total.
  consigneAmount Decimal  @default(0) @map("consigne_amount") @db.Decimal(12, 2)
  /// Cumul des versements recus sur cette commande.
  paidAmount  Decimal     @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentStatus OrderPaymentStatus @default(IMPAYEE) @map("payment_status")
  notes       String?
  tourId      String?     @map("tour_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  client     Client      @relation(fields: [clientId], references: [id])
  tour       Tour?       @relation(fields: [tourId], references: [id])
  lines      OrderLine[]
  deliveries Delivery[]
  payments   Payment[]
  posSale    PosSale?

  @@map("orders")
}

model OrderLine {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  /// Articles offerts, livres en plus de la quantite facturee.
  bonusQuantity Int  @default(0) @map("bonus_quantity")
  /// Valeur des articles offerts, non deduite du total.
  bonus     Decimal @default(0) @db.Decimal(12, 2)
  /// Contenants vides rendus en echange par le client.
  emptiesReturned Int @default(0) @map("empties_returned")
  /// Contenants facturas en consigne faute de vide rendu.
  consigneQuantity Int @default(0) @map("consigne_quantity")
  consigneAmount Decimal @default(0) @map("consigne_amount") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_lines")
}

model Tour {
  id          String     @id @default(uuid())
  tourNumber  String     @unique @map("tour_number")
  zone        String
  date        DateTime   @db.Date
  driverId    String     @map("driver_id")
  vehicleId   String     @map("vehicle_id")
  status      TourStatus @default(PLANIFIEE)
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  driver     User       @relation("TourDriver", fields: [driverId], references: [id])
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
  orders     Order[]
  deliveries Delivery[]
  loadSheets LoadSheet[]

  optimizedRoutes OptimizedRoute[]
  esgIndicators   EsgIndicator[]
  discrepancies   Discrepancy[]

  @@map("tours")
}

model LoadSheet {
  id              String   @id @default(uuid())
  tourId          String   @map("tour_id")
  validatedByStore Boolean @default(false) @map("validated_by_store")
  validatedByDriver Boolean @default(false) @map("validated_by_driver")
  items           Json
  createdAt       DateTime @default(now()) @map("created_at")

  tour Tour @relation(fields: [tourId], references: [id])

  @@map("load_sheets")
}

model Delivery {
  id              String         @id @default(uuid())
  deliveryNumber  String         @unique @map("delivery_number")
  orderId         String         @map("order_id")
  clientId        String         @map("client_id")
  tourId          String         @map("tour_id")
  driverId        String         @map("driver_id")
  status          DeliveryStatus @default(EN_ATTENTE)
  deliveredAt     DateTime?      @map("delivered_at")
  latitude        Float?
  longitude       Float?
  signatureUrl    String?        @map("signature_url")
  photoUrl        String?        @map("photo_url")
  clientCode      String?        @map("client_code")
  notes           String?
  localId         String?        @unique @map("local_id")
  syncStatus      SyncStatus     @default(SYNCED) @map("sync_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  order    Order          @relation(fields: [orderId], references: [id])
  client   Client         @relation(fields: [clientId], references: [id])
  tour     Tour           @relation(fields: [tourId], references: [id])
  driver   User           @relation(fields: [driverId], references: [id])
  lines    DeliveryLine[]
  payments Payment[]

  @@map("deliveries")
}

model DeliveryLine {
  id           String  @id @default(uuid())
  deliveryId   String  @map("delivery_id")
  productId    String  @map("product_id")
  qtyDelivered Int     @map("qty_delivered")
  qtyReturned  Int     @default(0) @map("qty_returned")
  qtyDamaged   Int     @default(0) @map("qty_damaged")
  qtyRefused   Int     @default(0) @map("qty_refused")
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("delivery_lines")
}

model ConsigneMovement {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  deliveryId  String?  @map("delivery_id")
  orderId     String?  @map("order_id")
  posSaleId   String?  @map("pos_sale_id")
  productFormat ProductFormat @map("product_format")
  source      ConsigneMovementSource @default(LIVRAISON)
  qtyIn       Int      @default(0) @map("qty_in")
  qtyOut      Int      @default(0) @map("qty_out")
  /// Solde du client pour ce format apres le mouvement.
  balanceAfter Int     @map("balance_after")
  /// Valeur unitaire de consigne appliquee au mouvement.
  unitValue   Decimal  @default(0) @map("unit_value") @db.Decimal(12, 2)
  /// Valeur nette du mouvement (positive si le client s'endette).
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, productFormat])
  @@map("consigne_movements")
}

/// Solde de contenants vides dus par un client, par format, avec sa valorisation.
model ClientConsigneBalance {
  id            String        @id @default(uuid())
  clientId      String        @map("client_id")
  productFormat ProductFormat @map("product_format")
  quantity      Int           @default(0)
  amount        Decimal       @default(0) @db.Decimal(12, 2)
  updatedAt     DateTime      @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, productFormat])
  @@index([clientId])
  @@map("client_consigne_balances")
}

model Payment {
  id          String        @id @default(uuid())
  paymentNumber String      @unique @map("payment_number")
  deliveryId  String?       @map("delivery_id")
  orderId     String?       @map("order_id")
  clientId    String?       @map("client_id")
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  collectedBy String        @map("collected_by")
  localId     String?       @unique @map("local_id")
  syncStatus  SyncStatus    @default(SYNCED) @map("sync_status")
  createdAt   DateTime      @default(now()) @map("created_at")

  delivery  Delivery? @relation(fields: [deliveryId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id])
  collector User      @relation(fields: [collectedBy], references: [id])
  posSale   PosSale?
  financeMovement FinanceMovement?

  @@map("payments")
}

/// Vente comptoir au point de vente (caisse).
model PosSale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique @map("sale_number")
  clientId      String        @map("client_id")
  cashierId     String        @map("cashier_id")
  orderId       String?       @unique @map("order_id")
  paymentId     String?       @unique @map("payment_id")
  method        PaymentMethod
  status        PosSaleStatus @default(PAYEE)
  subtotal      Decimal       @db.Decimal(12, 2)
  bonus         Decimal       @default(0) @db.Decimal(12, 2)
  /// Part de consigne facturee comprise dans le total.
  consigneAmount Decimal      @default(0) @map("consigne_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  cashReceived  Decimal?      @map("cash_received") @db.Decimal(12, 2)
  changeGiven   Decimal?      @map("change_given") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  client  Client       @relation(fields: [clientId], references: [id])
  cashier User         @relation("PosCashier", fields: [cashierId], references: [id])
  order   Order?       @relation(fields: [orderId], references: [id])
  payment Payment?     @relation(fields: [paymentId], references: [id])
  lines   PosSaleLine[]

  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@map("pos_sales")
}

model PosSaleLine {
  id           String  @id @default(uuid())
  saleId       String  @map("sale_id")
  productId    String  @map("product_id")
  quantity     Int
  catalogPrice Decimal @map("catalog_price") @db.Decimal(12, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  /// Articles offerts, remis en plus de la quantite facturee.
  bonusQuantity Int    @default(0) @map("bonus_quantity")
  /// Valeur des articles offerts, non deduite du total.
  bonus        Decimal @default(0) @db.Decimal(12, 2)
  /// Contenants vides rendus en echange par le client.
  emptiesReturned Int  @default(0) @map("empties_returned")
  /// Contenants facturas en consigne faute de vide rendu.
  consigneQuantity Int @default(0) @map("consigne_quantity")
  consigneAmount Decimal @default(0) @map("consigne_amount") @db.Decimal(12, 2)

  sale    PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("pos_sale_lines")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SyncEvent {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  deviceId   String     @map("device_id")
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id")
  localId    String     @map("local_id")
  payload    Json
  status     SyncStatus @default(PENDING)
  syncedAt   DateTime?  @map("synced_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sync_events")
}

model ProductionOrder {
  id            String                @id @default(uuid())
  orderNumber   String                @unique @map("order_number")
  lotNumber     String                @unique @map("lot_number")
  productFormat ProductFormat         @map("product_format")
  lineCode      String                @map("line_code")
  plannedQty    Int                   @map("planned_qty")
  producedQty   Int                   @default(0) @map("produced_qty")
  status        ProductionOrderStatus @default(PLANIFIE)
  lotStatus     LotStatus             @default(EN_PRODUCTION) @map("lot_status")
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  qualityChecks QualityCheck[]

  @@map("production_orders")
}

model QualityCheck {
  id                String             @id @default(uuid())
  productionOrderId String?            @map("production_order_id")
  lotNumber         String             @map("lot_number")
  ph                Float?
  chlorineFree      Float?             @map("chlorine_free")
  tds               Float?
  turbidity         Float?
  microbiologyOk    Boolean?           @map("microbiology_ok")
  status            QualityCheckStatus @default(EN_ATTENTE)
  validatedBy       String?            @map("validated_by")
  validatedAt       DateTime?          @map("validated_at")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")

  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@map("quality_checks")
}

model ShiftAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  postLabel String   @map("post_label")
  notes     String?
  validated Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("shift_assignments")
}

model DailyActivityReport {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        DateTime @db.Date
  activities  Json
  incidents   String?
  validated   Boolean  @default(false)
