{
  "name": "emmapp",
  "version": "3.1.0",
  "private": true,
  "description": "EMMAPP v3.1.0 - ERP/CRM eau potable",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "backend:install": "cd backend && npm install",
    "backend:dev": "cd backend && npm run start:dev",
    "backend:setup": "cd backend && npx prisma migrate dev --name init && npm run prisma:seed",
    "backoffice:install": "cd backoffice && npm install",
    "backoffice:dev": "cd backoffice && npm run dev",
    "mobile:get": "cd mobile && flutter pub get",
    "docs:cahier": "node tools/generate-cahier-charges.mjs"
  }
}
